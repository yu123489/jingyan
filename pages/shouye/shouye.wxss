/* 页面整体背景和间距 */
.container {
  padding: 20rpx;
  /* background-color: #f5f6f8;  */
  min-height: 100vh;
}

/* --- 第一部分：顶部信息栏 --- */
.location-header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 20rpx;
  background: linear-gradient(135deg, #f7f5f3 0%, #f5e9d4 100%);
  border-radius: 28rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(85, 68, 47, 0.06);
}

.location-inner {
  display: flex;
  align-items: center;
}

.ancient-icon {
  font-size: 28rpx;
  color: #8b5a2b; /* 沉稳的古铜/棕褐色 */
  margin-right: 12rpx;
}

.city-name {
  font-weight: bold;
  font-size: 32rpx;
  color: #3d3326; /* 墨黑带点古沉感 */
  letter-spacing: 2rpx;
}

.ancient-suffix {
  font-size: 24rpx;
  color: #8c7b65;
  margin-left: 10rpx;
}

.ancient-tag {
  font-size: 24rpx;
  color: #9e4722; /* 类似朱砂印泥的中国红/铁锈红 */
  font-weight: 500;
  letter-spacing: 2rpx;
  background-color: #f7ede2;
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
  border: 1rpx solid #e6d2be;
}

/* --- 第二部分：动态 Banner --- */
.banner-section {
  width: 100%;
  height: 360rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  overflow: hidden; /* 保证圆角生效 */
  background-color: #ffffff;
}
.banner-swiper {
  width: 100%;
  height: 100%;
}
.banner-img {
  width: 100%;
  height: 100%;
  background-color: #e0e0e0;
}

/* --- 第三部分：三大功能入口 --- */
.nav-grid {
  display: flex;
  justify-content: space-between; 
  padding: 30rpx 20rpx; 
  background: linear-gradient(135deg, #fcfbfa 0%, #EEE6CB 100%) !important;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
  width: 100%; 
  box-sizing: border-box; 
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1; 
}

.circle {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%; 
  background-color: #f0f0f0; 
  margin-bottom: 12rpx;
}

.grid-item text {
  font-size: 24rpx;
  color: #444;
  text-align: center; 
  white-space: nowrap; 
}

/* --- 第四部分：横滑时空长卷（大唐古风美化版） --- */
.ancient-timeline-card {
  /* 运用大唐米色底纹与精致的石青蓝边框 */
  background: linear-gradient(135deg, #fcfbfa 0%, #EEE6CB 100%) !important;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 16rpx rgba(67, 108, 133, 0.12);
}

/* 带有题签感的标题行 */
.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  border-bottom: 2rpx dashed #d4c4a8;
  padding-bottom: 12rpx;
}

.title-left {
  display: flex;
  align-items: center;
}

.title-icon {
  font-size: 28rpx;
  color: #B73F42; /* 朱砂红点缀 */
  margin-right: 10rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #436C85; /* 沉稳的石青蓝主标题 */
  letter-spacing: 2rpx;
}

.title-right {
  font-size: 24rpx;
  color: #B73F42; /* 朱砂红印章风小标 */
  font-weight: 500;
  letter-spacing: 2rpx;
  background-color: #f7ede2;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  border: 1rpx solid #e6d2be;
}

/* 横滑区域滚动框 */
.scroll-area {
  width: 100%;
  height: 420rpx; 
  white-space: nowrap; 
  border-radius: 12rpx;
  background-color: #f4efe1;
  border: 1rpx solid #dcd3b8;
}

/* 长卷图片呈现 */
.long-image {
  height: 100%; 
  display: inline-block; 
  background-color: #EEE6CB; 
  border-radius: 8rpx;
}

/* --- 第五部分：每日卡片 --- */
.daily-card-section {
  background: linear-gradient(135deg, #fcfbfa 0%, #EEE6CB 100%) !important;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
}

.section-title{
  font-size: 32rpx;
  font-weight: bold;
  color: #436C85; /* 沉稳的石青蓝主标题 */
  letter-spacing: 2rpx;
}

.daily-card {
  width: 100%;
  min-height: 120rpx;
  display: flex;
  align-items: center;
  /* background-color: #f9f9f9; */
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
}
.daily-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
}