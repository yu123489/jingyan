
<view class="container">

<!-- 第一部分：动态定位栏 -->
<view class="location-header" bindtap="requestLocation">
  <view class="location-inner">
    <!-- 用古风印章或传统云纹符号代替普通定位针 -->
    <text class="ancient-icon">❖</text>
    <text class="city-name">{{ locationName || '寻迹中...' }}</text>
    <text class="ancient-suffix">· 盐道古地</text>
  </view>
</view>

<!-- 第二部分：动态 Banner -->
<view class="banner-section">
  <swiper class="banner-swiper" indicator-dots="true" autoplay="true" circular="true">
    <swiper-item wx:for="{{bannerImages}}" wx:key="index">
      <image class="banner-img" src="{{item}}" mode="aspectFill"></image>
    </swiper-item>
  </swiper>
</view>

<!-- 第三部分：四个圆形功能入口 -->
<view class="nav-grid">
  <view class="grid-item" bindtap="goToFeature" data-target="yun-lv">
    <view class="circle"></view>
    <text>盐工韵律</text>
  </view>
  <view class="grid-item" bindtap="goToFeature" data-target="lu-xian">
    <view class="circle"></view>
    <text>答题积分</text>
  </view>
  <view class="grid-item" bindtap="goToFeature" data-target="xun-bao">
    <view class="circle"></view>
    <text>盐运寻宝</text>
  </view>
</view>

<!-- 第四部分：横滑时空长卷（大唐古风版） -->
<view class="card-container ancient-timeline-card">
  <view class="timeline-header">
    <view class="title-left">
      <text class="title-icon">❖</text>
      <text class="title-text">盐脉微纪元</text>
    </view>
    <text class="title-right">【 历史长卷 】</text>
  </view>
  
  <!-- 下方可自由横滑的图片容器 -->
  <scroll-view class="scroll-area" scroll-x="true" enhanced="true" show-scrollbar="false">
    <image class="long-image" src="../../images/屏幕截图 2026-08-09 140829.png" mode="heightFix"></image>
  </scroll-view>
</view>

<!-- 第五部分：动态每日卡片 -->
<view class="daily-card-section">
  <text class="title-icon">❖</text>
  <text class="section-title">{{dailyTitle}}</text>
  <image class="section-image" src="/images/82878eb1d5a43385e8933be6516f9112.jpg" mode="widthFix"></image>
  <view class="daily-card">
    <text class="daily-text">{{dailyContent}}</text>
  </view>
</view>

</view>