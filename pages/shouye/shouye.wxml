
<view class="container">

<!-- 第一部分：动态定位栏 -->
<view class="location-header" bindtap="requestLocation">
  <view class="location-inner">
    <!-- 用古风印章或传统云纹符号代替普通定位针 -->
    <text class="ancient-icon">❖</text>
    <text class="city-name">{{ locationName || '寻迹中...' }}</text>
    <text class="ancient-suffix">· 盐道古地</text>
  </view>
</view>

<!-- 第二部分：动态 Banner -->
<view class="banner-section">
  <swiper class="banner-swiper" indicator-dots="true" autoplay="true" circular="true">
    <swiper-item wx:for="{{bannerImages}}" wx:key="index">
      <image class="banner-img" src="{{item}}" mode="aspectFill"></image>
    </swiper-item>
  </swiper>
</view>

<!-- 第三部分：3个圆形功能入口 -->
<view class="nav-grid">
  <view class="grid-item" bindtap="goToFeature" data-target="yun-lv">
    <view class="circle">
      <image class="circle-img" src="https://salt-miniprogram.oss-cn-chengdu.aliyuncs.com/tubiao/tubiao/yangongyunlv.png" mode="aspectFill"></image>
    </view>
    <text>盐工韵律</text>
  </view>
  <view class="grid-item" bindtap="goToFeature" data-target="lu-xian">
    <view class="circle">
      <image class="circle-img" src="https://salt-miniprogram.oss-cn-chengdu.aliyuncs.com/tubiao/tubiao/datijifen.png" mode="aspectFill"></image>
    </view>
    <text>答题积分</text>
  </view>
  <view class="grid-item" bindtap="goToFeature" data-target="xun-bao">
    <view class="circle">
      <image class="circle-img" src="https://salt-miniprogram.oss-cn-chengdu.aliyuncs.com/tubiao/tubiao/yanyunxunbao.png" mode="aspectFill"></image>
    </view>
    <text>盐运寻宝</text>
  </view>
</view>

<!-- 第四部分：横滑时空长卷（大唐古风版） -->
<view class="card-container ancient-timeline-card">
  <view class="timeline-header">
    <view class="title-left">
      <text class="title-icon">❖</text>
      <text class="title-text">盐脉微纪元</text>
    </view>
  </view>
  
  <!-- 下方可自由横滑的图片容器 -->
  <scroll-view class="scroll-area" scroll-x="true" enhanced="true" show-scrollbar="false">
    <image class="long-image" src="../../images/pic.jpg" mode="heightFix"></image>
  </scroll-view>
</view>

<!-- 每日盐识区块 -->
<view class="daily-card-section">
  <view class="timeline-header">
    <view class="title-left">
      <text class="title-icon">❖</text>
      <text class="section-title">{{dailyTitle}}</text>
    </view>
  </view>
  
  <view class="daily-card">
    <view class="daily-item-title">{{dailyData.title}}</view>
    <!-- 摘要区块：采用引言卡片样式 -->
    <view class="daily-item-summary">
      <text class="quote-mark left">“</text>
      <text class="summary-text">{{dailyData.summary}}</text>
      <text class="quote-mark right">”</text>
    </view>
    <!-- 正文区块 -->
    <view class="daily-item-content">{{dailyData.content}}</view>
  </view>
</view>

</view>