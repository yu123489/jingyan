<view class="container">
  
  <!-- 顶部控制区 -->
  <view class="top-console">
    <view class="top-btn" bindtap="navigateTo" data-url="/pages/points/points">我的积分</view>
    <view class="top-btn" bindtap="navigateTo" data-url="/pages/checkin/checkin">打卡记录</view>
  </view>

  <!-- 主展示区 -->
  <view class="main-display-area">
    
    <!-- 动态地图展示区 -->
    <view class="content-view" wx:if="{{currentTab === 'gudao'}}">
      
     <movable-area class="map-board" scale-area="{{true}}">
        <movable-view class="map-view" direction="all" scale="{{true}}" scale-min="{{1}}" scale-max="{{4}}" scale-value="{{scaleValue}}" bindscale="onScale">
          <view class="map-wrapper" >
            <!-- 背景  -->
            <image class="layer-bg" src="https://salt-miniprogram.oss-cn-chengdu.aliyuncs.com/routes/%E8%83%8C%E6%99%AF.png" mode="aspectFit"></image>
  
            <!--地图轮廓 -->
            <image class="layer-outline" src="https://salt-miniprogram.oss-cn-chengdu.aliyuncs.com/routes/%E5%9C%B0%E5%9B%BE%E8%83%8C%E6%99%AF.png"   mode="aspectFit"></image>
  
            <!-- 古道路线与打卡点标注  -->
            <image class="layer-route" src="{{routeImages[currentSubTab]}}" mode="aspectFit" wx:if="{{currentTab === 'gudao'}}"></image>

            <!-- 动态文字与打卡点 -->
            <block wx:for="{{routesData}}" wx:key="routeId" wx:for-item="route">
  
              <!-- 核心逻辑：只有在“路线全览”或者“当前选中路线”时，才渲染这组点位 -->
              <block wx:if="{{currentSubTab === 'all' || currentSubTab === route.routeId}}">
    
                <!-- 第二层循环：渲染该路线下的所有具体地点 -->
                <view wx:for="{{route.points}}" wx:key="name" wx:for-item="point" class="point-marker {{point.textPos || 'pos-bottom'}}" style="top: {{point.top}}; left: {{point.left}};" bindtap="handlePointClick" data-point="{{point}}">
      
                  <!-- 统一读取外层 route 的 color -->
                  <view class="point-dot" style="background-color: {{route.color}};"></view> 
                  <text class="point-text">{{point.name}}</text>
      
                </view>
              </block>
            </block>
          </view>
        </movable-view>
      </movable-area>

      <!-- 悬浮在地图上的信息卡片 -->
      <view class="map-info-card">
        <text class="info-title">❖ {{gudaoBtnText}}</text>
        <text class="info-desc">{{mapDesc[currentSubTab]}}</text>
      </view>

      <view class="zoom-controls">
        <view class="zoom-btn" bindtap="zoomIn">＋</view>
        <view class="zoom-btn" bindtap="zoomOut">−</view>
      </view>
      
    </view>

    <!-- 盐业聚落内容 -->
    <view class="content-view" wx:if="{{currentTab === 'juluo'}}">
      <view class="placeholder-box">
        <text class="title">盐业聚落</text>
        <text class="subtitle">这里未来可以接入聚落3D模型展示</text>
      </view>
    </view>
  </view>

  <!-- 底部控制区（包含滑出菜单和大按钮） -->
  <view class="bottom-container">
    
    <!-- 悬浮的子菜单：5个古道分支 -->
    <view class="sub-menu {{showSubMenu ? 'show' : ''}}">
      <view class="sub-btn {{currentSubTab === 'all' ? 'sub-active' : ''}}" bindtap="switchSubTab" data-sub="all" data-name="川盐古道">路线全览</view>

      <view class="sub-btn {{currentSubTab === 'route1' ? 'sub-active' : ''}}" bindtap="switchSubTab" data-sub="route1" data-name="川黔古道">川黔古道</view>
      <view class="sub-btn {{currentSubTab === 'route2' ? 'sub-active' : ''}}" bindtap="switchSubTab" data-sub="route2" data-name="川滇古道">川滇古道</view>
      <view class="sub-btn {{currentSubTab === 'route3' ? 'sub-active' : ''}}" bindtap="switchSubTab" data-sub="route3" data-name="川湘古道">川湘古道</view>
      <view class="sub-btn {{currentSubTab === 'route4' ? 'sub-active' : ''}}" bindtap="switchSubTab" data-sub="route4" data-name="川鄂古道">川鄂古道</view>
      <view class="sub-btn {{currentSubTab === 'route5' ? 'sub-active' : ''}}" bindtap="switchSubTab" data-sub="route5" data-name="南丝绸之路">南丝绸之路</view>
    </view>

    <!-- 底部两个常驻的大按钮 -->
    <view class="bottom-console">
      <view class="bottom-btn {{currentTab === 'gudao' ? 'active' : ''}}" bindtap="switchTab" data-tab="gudao">{{gudaoBtnText}}</view>
      <view class="bottom-btn {{currentTab === 'juluo' ? 'active' : ''}}" bindtap="switchTab" data-tab="juluo">盐业聚落</view>
    </view>
    
  </view>
</view>