/* ================= 全局布局 ================= */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  width: 100vw;
  position: relative;
  overflow: hidden; 
}

/* ================= 顶部按钮 ================= */
.top-console {
  position: absolute;
  top: 20rpx; 
  left: 30rpx;
  right: 30rpx;
  display: flex;
  justify-content: space-between;
  z-index: 100; 
}
.top-btn {
  background-color: #ffffff;
  padding: 16rpx 40rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  border: 2rpx solid #eaeaea;
}

/* ================= 主展示区 ================= */
.main-display-area {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1; 
  background-color: transparent;
  border-radius: 0; 
  box-shadow: none; 
}
.content-view {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}
.placeholder-box {
  text-align: center;
  padding: 40rpx;
}
.placeholder-box .title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #444;
  margin-bottom: 20rpx;
}
.placeholder-box .subtitle {
  display: block;
  font-size: 26rpx;
  color: #888;
}

/* ================= 底部容器与子菜单悬浮 ================= */
.bottom-container {
  position: absolute;
  bottom: 40rpx;
  left: 30rpx;
  right: 30rpx;
  z-index: 99;
}
.bottom-console {
  display: flex;
  justify-content: space-between;
  width: 100%;
  position: relative;
  z-index: 100; 
}

.bottom-btn {
  flex: 1;
  text-align: center;
  background-color: #ffffff;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #333;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  transition: all 0.2s;
}
.bottom-btn:first-child {
  margin-right: 30rpx;
}
.bottom-btn.active {
  background-color: #436C85;
  color: #ffffff;
  font-weight: bold;
  box-shadow: 0 6rpx 16rpx rgba(67, 108, 133, 0.3);
  border: none;
}

/* 子菜单核心悬浮逻辑 */
.sub-menu {
  position: absolute;
  left: 0;
  bottom: 110%; 
  width: calc(50% - 15rpx); 
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transform: translateY(30rpx);
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  z-index: 90;
}

.sub-menu.show {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateY(0);
}

.sub-btn {
  background-color: #f7f4eb;
  color: #436C85;
  padding: 18rpx 0;
  text-align: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: 2rpx solid #d4c4a8;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.08);
  transition: all 0.2s;
}
.sub-btn.sub-active {
  background-color: #436C85;
  color: #ffffff;
  font-weight: bold;
  border-color: #436C85;
}

/* ================= 动态地图展示区样式 ================= */
.map-board {
  width: 100vw;
  height: 100vh;
  background-color: #EEE6CB; 
  overflow: hidden; 
}

.map-view {
  width: 100vw; 
  height: 100vh; 
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 打包木板层 */
.map-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
}

/* 统一定义三层图片：占满容器并绝对定位 */
.layer-bg, .layer-outline, .layer-route {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

/* 底层羊皮纸 */
.layer-bg {
  z-index: 1;
}

/* 中层省份轮廓 */
.layer-outline {
  z-index: 2;
  pointer-events: none; 
}

/* 顶层路线动态层 */
.layer-route {
  z-index: 3;
  pointer-events: none; 
}

.map-image {
  width: 100%; 
  display: block;
}


/* 悬浮在地图左上角的信息卡片 */
.map-info-card {
  position: absolute;
  top: 150rpx;
  left: 30rpx;
  background: linear-gradient(135deg, #fcfbfae7 0%, #EEE6CB 100%) !important;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid #d4c4a8;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  max-width: 60%;
  z-index: 10;
  pointer-events: none; 
}

.info-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #436C85; 
  margin-bottom: 12rpx;
}

.info-desc {
  display: block;
  font-size: 24rpx;
  color: #55442f;
  line-height: 1.5;
}

/* ================= 悬浮缩放控件 ================= */
.zoom-controls {
  position: absolute;
  right: 30rpx;
  bottom: 220rpx; 
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 100;
}

.zoom-btn {
  width: 80rpx;
  height: 80rpx;
  background-color: rgba(247, 244, 235, 0.95); 
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 44rpx;
  font-weight: bold;
  color: #436C85; 
  border: 2rpx solid #d4c4a8;
}

.zoom-btn:active {
  background-color: #e5dfcf; 
}

/* ================= 互动打卡点基础样式 ================= */
.point-marker {
  position: absolute;
  display: flex;
  align-items: center; 
  transform: translate(-50%, -50%); 
  z-index: 10; 
  padding: 10rpx; 
}

/* 四个方向的排列魔法 */
.pos-bottom { flex-direction: column; }         /* 竖排，文字在下 */
.pos-top    { flex-direction: column-reverse; } /* 竖排反向，文字在上 */
.pos-right  { flex-direction: row; }            /* 横排，文字在右 */
.pos-left   { flex-direction: row-reverse; }    /* 横排反向，文字在左 */

/* 根据方向，自动调整文字的留白，避免文字贴着红点 */
.pos-bottom .point-text { margin-top: 1rpx; }
.pos-top    .point-text { margin-bottom: 1rpx; }
.pos-right  .point-text { margin-left: 1rpx; }
.pos-left   .point-text { margin-right: 1rpx; }

/* 红点和文字的本身样式保持不变 */
.point-dot {
  width: 8rpx;
  height: 8rpx;
  background-color: #A33B29; 
  border: 1rpx solid #F7F4EB; 
  border-radius: 50%;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.3);
  flex-shrink: 0; 
}

.point-text {
  font-size: 15rpx;
  color: #333333;
  font-weight: bold;
  letter-spacing: 1rpx;
  text-shadow: 0.5px 0.5px 0px #F7F4EB, -0.5px -0.5px 0px #F7F4EB, 0.5px -0.5px 0px #F7F4EB, -0.5px 0.5px 0px #F7F4EB; 
  white-space: nowrap; 
}