/* 页面整体背景与内边距 */
.container {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部标题 */
.header-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}

/* 按钮组通用布局 */
.button-group {
  display: flex;
  width: 100%;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

/* 独立按钮样式 */
.action-btn {
  width: 48%; 
  background-color: #ffffff;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
  transition: all 0.2s; 
}

/* 按钮选中/激活状态的高亮样式 */
.active-btn {
  background-color: #436C85;
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(0, 122, 255, 0.3);
}

/* 核心3D模型渲染区 */
.model-display-area {
  position: relative; 
  width: 100%;
  height: 600rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: inset 0 4rpx 12rpx rgba(0,0,0,0.05);
}

/* WebGL Canvas 标准配置 */
.webgl-canvas {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
}

/* 悬浮在3D区域内的交互工具台 */
.model-tools {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  display: flex;
  flex-direction: column;
  z-index: 10; 
}

.tool-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

/* 临时显示文字，用于验证数据流转 */
.current-exhibit-name {
  position: absolute;
  bottom: 20rpx;
  color: #555;
  font-size: 28rpx;
  font-weight: bold;
  z-index: 10;
}


/* 底部展品长廊样式  */

/* 控制背景与边距 */
.gallery-section-new {
  width: 100%;
  background: linear-gradient(135deg, #fcfbfa 0%, #EEE6CB 100%) !important;
  padding: 30rpx 0 30rpx 30rpx; 
  border-radius: 16rpx;
  margin-bottom: 40rpx;
  box-sizing: border-box;
}

/* 滚动核心：强制不换行 */
.gallery-scroll-new {
  width: 100%;
  white-space: nowrap; 
}

/* 独立卡片单元*/
.gallery-card-new {
  display: inline-block; 
  width: 200rpx; 
  margin-right: 40rpx; 
  vertical-align: top; 
  text-align: center;
}

/* 控制缩放和边框 */
.card-image-box-new {
  width: 200rpx;
  height: 200rpx;
  margin: 10rpx auto 16rpx auto;
  border-radius: 16rpx;
  overflow: hidden; 
  transition: all 0.2s ease-in-out;
}

/* 实际的图片元素 */
.card-image-new {
  width: 100%;
  height: 100%;
  display: block;
}

/* 文本样式 */
.card-text-new {
  display: block;
  font-size: 24rpx;
  color: #444444;
  white-space: normal; 
  line-height: 1.4;
}

/* --- 选中状态高亮增强 --- */
.active-card-new .card-image-box-new {
  transform: scale(1.08); 
  border: 4rpx solid #436C85; 
  box-sizing: border-box; 
  box-shadow: 0 8rpx 16rpx rgba(0, 122, 255, 0.2);
}

.active-card-new .card-text-new {
  color: #436C85;
  font-weight: bold;
}


/* 详细信息文字展示区样式 */
.detail-text-view {
  width: 100%;
  height: 100%;
  padding: 40rpx;
  box-sizing: border-box;
  background-color: #F7F4EB;
}

.detail-content {
  font-size: 30rpx;
  color: #444444;
  line-height: 1.8;
  letter-spacing: 2rpx;
  text-align: justify;
}