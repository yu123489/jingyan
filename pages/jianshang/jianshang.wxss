/* 页面整体背景与内边距 */
.container {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部标题 */
.header-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}

/* 按钮组通用布局 */
.button-group {
  display: flex;
  width: 100%;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

/* 独立按钮样式 */
.action-btn {
  width: 48%; 
  background-color: #ffffff;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
  transition: all 0.2s; /* 点击动画过渡 */
}

/* 按钮选中/激活状态的高亮样式 */
.active-btn {
  background-color: #007aff;
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(0, 122, 255, 0.3);
}

/* 核心 3D 模型渲染区 */
.model-display-area {
  position: relative; /* 开启相对定位，方便工具栏绝对定位悬浮 */
  width: 100%;
  height: 600rpx;
  background-color: #e8ebf0; /* 类似工业软件的极简高级灰背景 */
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: inset 0 4rpx 12rpx rgba(0,0,0,0.05);
}

/* WebGL Canvas 标准配置 */
.webgl-canvas {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
}

/* 悬浮在 3D 区域内的交互工具台 */
.model-tools {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  display: flex;
  flex-direction: column;
  z-index: 10; /* 确保悬浮在 canvas 之上 */
}

.tool-icon {
  width: 60rpx;
  height: 60rpx;
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

/* 临时显示文字，用于验证数据流转 */
.current-exhibit-name {
  position: absolute;
  bottom: 20rpx;
  color: #555;
  font-size: 28rpx;
  font-weight: bold;
  z-index: 10;
}

/* 展品长廊区域 */
.gallery-section {
  background-color: #ffffff;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 8rpx; 
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}

.gallery-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.gallery-scroll {
  width: 100%;
  height: 250rpx;
  white-space: nowrap;
}

/* =========================================
   全新重构：底部展品长廊样式 (强制隔离版)
   ========================================= */

/* 外层区域：控制背景与边距 */
.gallery-section-new {
  width: 100%;
  background-color: #ffffff;
  padding: 30rpx 0 30rpx 30rpx; /* 故意不留右侧内边距，让滑块能彻底贴边滑出 */
  border-radius: 16rpx;
  margin-bottom: 40rpx;
  box-sizing: border-box;
}

/* 滚动核心：强制不换行 */
.gallery-scroll-new {
  width: 100%;
  white-space: nowrap; /* 核心：所有子元素必须在一行 */
}

/* 独立卡片单元：彻底隔绝 Flex 污染 */
.gallery-card-new {
  display: inline-block; /* 核心：回归行内块元素 */
  width: 150rpx; /* 宽度死锁，绝不缩小 */
  margin-right: 30rpx;
  vertical-align: top; /* 保证所有卡片顶部绝对齐平 */
  text-align: center;
}

/* 独立的图片盒子：控制缩放和边框 */
.card-image-box-new {
  width: 200rpx;
  height: 200rpx;
  margin: 10rpx auto 16rpx auto; /* 保证盒子在卡片内居中 */
  background-color: #e5e5e5; /* 默认灰色底，真实图片加载前显示 */
  border-radius: 16rpx;
  overflow: hidden; /* 防止图片溢出圆角 */
  transition: all 0.2s ease-in-out;
}

/* 实际的图片元素 */
.card-image-new {
  width: 100%;
  height: 100%;
  display: block;
}

/* 文本样式：允许内部文字换行 */
.card-text-new {
  display: block;
  font-size: 24rpx;
  color: #444444;
  white-space: normal; /* 局部恢复换行能力，防止名字过长被切断 */
  line-height: 1.4;
}

/* --- 选中状态高亮增强 --- */
.active-card-new .card-image-box-new {
  transform: scale(1.08); /* 微微放大 */
  border: 4rpx solid #007aff; /* 增加主题色边框 */
  box-sizing: border-box; /* 保证加了边框不改变整体尺寸 */
  box-shadow: 0 8rpx 16rpx rgba(0, 122, 255, 0.2);
}

.active-card-new .card-text-new {
  color: #007aff;
  font-weight: bold;
}