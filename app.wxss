
@font-face {
  font-family: 'myself';
  src: url('data:font/woff2;charset=utf-8;base64,') format('woff2'),
      url('data:font/woff;charset=utf-8;base64,') format('woff');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

/* app.wxss 文件中的全局样式 */
page {
  font-family: 'myself', sans-serif;
  background-color: #EEE6CB !important;
  color: #2c3e50;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  height: 100%;
}