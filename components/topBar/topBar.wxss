.top-landscape-header {
    width: 100%;
    height: 180rpx;
    overflow: hidden;
    position: relative;
    box-sizing: border-box;
    padding: 20rpx 30rpx;
    display: flex;
    align-items: center;
  }
  .landscape-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 400rpx; /* 放大高度向上偏移，只露上半截 */
    z-index: -1;
  }
  .nav-content {
    display: flex;
    align-items: center;
  }
  .ancient-icon {
    font-size: 28rpx;
    color: #8b5a2b;
    margin-right: 12rpx;
  }
  .city-name {
    font-weight: bold;
    font-size: 32rpx;
    color: #3d3326;
    letter-spacing: 2rpx;
  }