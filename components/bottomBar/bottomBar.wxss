.bottom-landscape-footer {
    width: 100%;
    height: 160rpx;
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 40rpx;
    border-top: 2rpx solid #d4c4a8;
  }
  .landscape-bottom-bg {
    position: absolute;
    top: -220rpx; /* 向上拉，只露下半截水面和小船 */
    left: 0;
    width: 100%;
    height: 400rpx;
    z-index: -1;
  }
  .footer-text {
    font-size: 24rpx;
    color: #55442f;
    letter-spacing: 2rpx;
    font-weight: 500;
    background-color: rgba(238, 230, 203, 0.7);
    padding: 4rpx 16rpx;
    border-radius: 4rpx;
  }